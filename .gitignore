# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories (in case you add npm/yarn later)
node_modules/

# Build directories
dist/
build/

# Temporary files
*.tmp
*.temp
*.swp

# Editor directories and files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# OS generated files
.DS_Store
Thumbs.db

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Cache files
.cache/
*.cache

# Coverage reports (if you add testing later)
coverage/

# Local development files
*.local

# Ignore ZIP files (since you might create these for distribution)
*.zip
*.tar.gz

# AI Memory - exclude personal conversation history
memories/sessions/*cursor-history*

# Raw content - local files only, never commit to GitHub
raw/
memory/raw/
# EXCEPTION: Publish Jarvis's learnings (public memory architecture)
!claw/memory/raw/
*.html.bak
chat.*
conversations.*
group_chats.*
message_feedback.*
shared_conversations.*
shopping.*
sora.*
basispoints.*
user-*/

# Large files that block GitHub Pages deployment
*.tar.gz
*.zip
*.rar
.env

# Opencode runtime artifacts
.sisyphus/
.vercel
.env*
.playwright-mcp/

# Local editor / AI workspace — not served by the site
.cursor/
.ai/
mcp-r2-upload/
scripts/

# Duplicate or internal docs (README.md is the public one)
VISION.md
ECOSYSTEM.md
README.mdx
components/README-*.md
components/comicReader/MOBILE_VIEWPORT_TESTING.md
components/comicReader/STYLE_SPEC.md

# Authoring notes; the site loads moments.js and content.html
moments/**/*.md
moments/**/raw/
